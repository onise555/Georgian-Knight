# ---------------------------------------------------------------
# Project-specific
# ---------------------------------------------------------------

# GKBridge: file bridge run output (frames, films, mp4s, logs, request.txt)
/GKBridge/

# Rendered videos
/Exports/

# Film pipeline work area (renders, review builds, reports); only Director-approved
# versions in Film/Approved/ are tracked (mp4/mov/wav go to LFS via .gitattributes)
/Film/*
!/Film/Approved/

# Downloaded raw assets (re-downloadable)
/AssetDownloads/
/MixamoDownloads/
/ContentSource/mpfb_packs/
/Tools/rokoko_addon/

# Old backups / caches / quarantine (stay on disk, not in git)
/_backup/
/_staging_quarantine/
/GKCache/
/ContentSource/backup/
*.bak
*.bak_*

# Blender auto-backups (.blend1, .blend2, ...)
*.blend[0-9]
*.blend[0-9][0-9]

# Python
__pycache__/
*.pyc

# API keys for the MCP servers — NEVER commit
/Tools/*/token.txt
token.txt
*.token
.env
