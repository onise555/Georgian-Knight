# This public copy stores binaries as plain git objects (no Git LFS): every file is under 100 MB.
# ---------------------------------------------------------------
# Georgian Knight — line endings and Git LFS
# ---------------------------------------------------------------

* text=auto

# Unity YAML (Force Text serialization) — keep as text, diffable
*.unity      text eol=lf
*.prefab     text eol=lf
*.mat        text eol=lf
*.anim       text eol=lf
*.controller text eol=lf
*.overrideController text eol=lf
*.meta       text eol=lf
*.playable   text eol=lf
*.asset      text eol=lf
*.physicMaterial text eol=lf
*.mask       text eol=lf
*.lighting   text eol=lf
*.terrainlayer text eol=lf
*.shadergraph text eol=lf
*.shadersubgraph text eol=lf

# Code
*.cs      text diff=csharp
*.shader  text
*.hlsl    text
*.cginc   text
*.asmdef  text
*.json    text
*.md      text
*.py      text
*.ps1     text
*.bat     text eol=crlf

